# Required. Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_long_random_secret
# Required AES-256-GCM key. Generate with:
# python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_ENCRYPTION_KEY=replace_with_aes_256_gcm_key
# Separate AES-256-GCM master key for encrypted market-data credentials.
CREDENTIAL_MASTER_KEY=replace_with_a_second_aes_256_gcm_key
SVIX_ADMIN_USERNAME=admin
SVIX_ADMIN_PASSWORD=change-me-before-first-start
DATABASE_URL=postgresql+psycopg://svix:svix@postgres:5432/svix
JWT_EXPIRE_MINUTES=15
REFRESH_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=true
DATA_PROVIDER=IBKR
IBKR_HOST=host.docker.internal
IBKR_PORT=7497
IBKR_CLIENT_ID=19
FUTU_HOST=host.docker.internal
FUTU_PORT=11111
POSTGRES_DB=svix
POSTGRES_USER=svix
POSTGRES_PASSWORD=change-postgres-password
