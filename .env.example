# Required. Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_long_random_secret
# Required AES-256-GCM key. Generate with:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n'
SECRET_ENCRYPTION_KEY=replace_with_aes_256_gcm_key
# Separate AES-256-GCM master key for encrypted market-data credentials.
CREDENTIAL_MASTER_KEY=replace_with_a_second_aes_256_gcm_key
SVIX_ADMIN_USERNAME=choose_your_admin_username
SVIX_ADMIN_PASSWORD=replace_with_a_strong_unique_password
JWT_EXPIRE_MINUTES=15
REFRESH_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
COOKIE_SECURE=true
# Dashboard exposure. Leave SVIX_HTTP_PORT empty for a random host port.
# Keep 127.0.0.1 when accessing through an SSH tunnel; use 0.0.0.0 only behind a firewall/HTTPS proxy.
SVIX_BIND_ADDRESS=127.0.0.1
SVIX_HTTP_PORT=
DATA_PROVIDER=ALPACA
# Full edition includes IBKR and Futu SDKs; Alpaca edition uses Dockerfile.alpaca.
IBKR_HOST=host.docker.internal
IBKR_PORT=7497
IBKR_CLIENT_ID=19
FUTU_HOST=host.docker.internal
FUTU_PORT=11111
ALPACA_BASE_URL=https://data.alpaca.markets
# indicative is free test data with modified quotes; use opra only with a paid subscription.
ALPACA_FEED=indicative
NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
POSTGRES_DB=svix
POSTGRES_USER=svix
POSTGRES_PASSWORD=replace_with_database_password
